# Add your values, then restart npm run dev. Keep this file private.
# MongoDB connection string (include your database name).
MONGO_DB_URL=

# Authentication: change this URL when deploying.
NEXTAUTH_URL=http://localhost:3000
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep the same secret across restarts and deployment instances to preserve sessions.
NEXTAUTH_SECRET=

# Google OAuth. Authorized redirect URI for local development:
# http://localhost:3000/api/auth/callback/google
GOOGLE_ID=
GOOGLE_SECRET=

# Server-side admin login credentials. Keep these private.
ADMIN_EMAIL=versanexinc@gmail.com
ADMIN_PASSWORD=
ADMIN_SECRET_CODE=
